{
    "name":  "@hireko/mcp-router",
    "version":  "0.1.0",
    "description":  "Local MCP router with Cognito auth injection and flattened server__tool surface for harnesses.",
    "type":  "module",
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "bin":  {
                "HirekoOpenPlugin":  "dist/cli/index.js"
            },
    "main":  "dist/index.js",
    "files":  [
                  "dist",
                  "infra",
                  "docs",
                  "skills",
                  "commands",
                  "AGENTS.md",
                  "plugin.json",
                  "mcp.json",
                  "deploy.json",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "prepare":  "npm run build",
                    "build":  "tsc -p tsconfig.build.json && node web/build.mjs",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "benchmark":  "tsx infra/benchmark.ts",
                    "demo":  "tsx infra/demo.ts",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "package:codex":  "node scripts/package-codex.mjs"
                },
    "keywords":  [
                     "mcp",
                     "model-context-protocol",
                     "gateway",
                     "proxy",
                     "cognito",
                     "router"
                 ],
    "dependencies":  {
                         "@aws-sdk/client-cognito-identity-provider":  "^3.700.0",
                         "@modelcontextprotocol/sdk":  "^1.12.0",
                         "commander":  "^12.1.0",
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8",
                         "zod":  "^3.24.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.17.0",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.4",
                            "esbuild":  "^0.28.2",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.6.0",
                            "vitest":  "^2.1.0"
                        }
}

